{
  "manifest_version": 3,
  "name": "Google相册上传与批量下载 · Google Photos Uploader",
  "short_name": "相册上传·批量下载",
  "version": "1.0.2",
  "description": "扫描网页图片，批量上传至 Google Photos，或下载原图并打包为 ZIP；支持筛选、预览与任务进度。 Scan, upload, download and ZIP web images.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Google相册上传与批量下载",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "src/options/options.html",
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "permissions": [
    "storage",
    "identity",
    "scripting",
    "alarms",
    "activeTab",
    "contextMenus",
    "clipboardWrite",
    "unlimitedStorage"
    ,"downloads", "windows"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "oauth2": {
    "client_id": "939056899862-a4q7o1f6od3orsspaflu311ltkou7pfg.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/photoslibrary.appendonly",
      "https://www.googleapis.com/auth/photoslibrary.readonly.appcreateddata",
      "openid",
      "email"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": ["src/content/main-fetcher.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
