PORT=8787
APP_BASE_URL=https://billing.example.com
NODE_ENV=production

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=web_image_uploader
DB_USER=web_image
DB_PASSWORD=change-me

JWT_SECRET=replace-with-at-least-32-random-chars
JWT_EXPIRES_IN=30d
ADMIN_EMAIL=admin@example.com

# 支付渠道默认关闭；真实密钥建议通过管理后台保存并加密存储
PAYMENT_MOCK_ENABLED=true
WECHAT_ENABLED=false
ALIPAY_ENABLED=false
PAYPAL_ENABLED=false

# 服务端中转图片限制
PROXY_MAX_BYTES=20971520
PROXY_TIMEOUT_MS=15000
